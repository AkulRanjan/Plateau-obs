# Matches .gitattributes, which keeps everything LF in the repo so a Windows
# checkout and a Linux checkout compare equal (rule 3).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 88

[*.{js,jsx,mjs,json,css,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown, so trimming them
# silently reflows prose.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Generated by web/scripts/extract_metrics.mjs and by the eval scripts. Both
# write their own formatting; do not let an editor reformat them.
[{metrics.json,web/src/data/fixtures.json}]
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab
